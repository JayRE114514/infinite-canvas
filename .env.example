# 运行环境，仅支持 development / test / production
NODE_ENV=development

# API 监听端口（1-65535）
PORT=4000

# 前端访问地址，必须是绝对 http(s) URL
APP_ORIGIN=http://localhost:3000

# 会话签名密钥，至少 32 个字符
BETTER_AUTH_SECRET=replace-with-a-32-character-secret

# PostgreSQL 连接串按登录角色分开配置。
# 角色创建与口令分配属于部署引导动作：先由数据库管理员执行
# server/database/bootstrap/roles.sql 创建 schema_owner / app_api / app_worker / app_maintenance，
# 再分别 ALTER ROLE ... PASSWORD 下发口令；仓库内不保存任何数据库口令。
# 迁移作业专用凭据，只有它拥有业务对象。
DATABASE_URL_SCHEMA_OWNER=postgres://schema_owner:replace-me@localhost:5432/infinite_canvas
# API 进程凭据
DATABASE_URL_API=postgres://app_api:replace-me@localhost:5432/infinite_canvas
# Worker 进程凭据
DATABASE_URL_WORKER=postgres://app_worker:replace-me@localhost:5432/infinite_canvas
# 运维只读凭据
DATABASE_URL_MAINTENANCE=postgres://app_maintenance:replace-me@localhost:5432/infinite_canvas

# PostgreSQL 连接池上限（1-50）
DB_POOL_MAX=10

# 邮件发送配置，SMTP_USER / SMTP_PASSWORD 可留空
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# 平台积分图片能力；false 时下列配置不读取。启用时所有字段必须显式填写。
PLATFORM_IMAGE_ENABLED=false
# PLATFORM_IMAGE_CAPABILITY_ID=
# PLATFORM_IMAGE_ROUTE_ID=
# PLATFORM_IMAGE_ADAPTER_ID=
# PLATFORM_IMAGE_ADAPTER_VERSION=
# PLATFORM_IMAGE_EXACT_MODEL_ID=
# PLATFORM_IMAGE_PRICE_VERSION=
# PLATFORM_IMAGE_ESTIMATED_CREDITS=
# PLATFORM_IMAGE_FIXED_CREDITS=
# PLATFORM_IMAGE_PROVIDER_BASE_URL=
# PLATFORM_IMAGE_PROVIDER_API_KEY=
# 自建 S3 兼容端点固定使用 path-style（endpoint/bucket/object-key），不提供运行期开关。
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REQUEST_TIMEOUT_MS=
# S3_MAX_ATTEMPTS=
# AI_WORKER_LEASE_DURATION_MS=
# AI_WORKER_HEARTBEAT_INTERVAL_MS=
# AI_PROVIDER_HTTP_TIMEOUT_MS=
# AI_PROVIDER_SAFE_RETRY_BUDGET=
# PG_BOSS_QUEUE_CONCURRENCY=
# PG_BOSS_JOB_RETRY_COUNT=
