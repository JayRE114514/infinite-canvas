# 运行环境，仅支持 development / test / production
NODE_ENV=development

# API 监听端口（1-65535）
PORT=4000

# 前端访问地址，必须是绝对 http(s) URL
APP_ORIGIN=http://localhost:3000

# 会话签名密钥，至少 32 个字符
BETTER_AUTH_SECRET=replace-with-a-32-character-secret

# PostgreSQL 连接串
DATABASE_URL=postgres://postgres:postgres@localhost:5432/infinite_canvas

# PostgreSQL 连接池上限（1-50）
DB_POOL_MAX=10

# 邮件发送配置，SMTP_USER / SMTP_PASSWORD 可留空
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
