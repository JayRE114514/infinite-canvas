# 运行环境，仅支持 development / test / production
NODE_ENV=development

# API 监听端口（1-65535）
PORT=4000

# API 监听地址；Nginx 与 API 同机时保持回环地址
HOST=127.0.0.1

# 前端访问地址，必须是绝对 http(s) URL
APP_ORIGIN=http://localhost:3000

# 会话签名密钥，至少 32 个字符
BETTER_AUTH_SECRET=replace-with-a-32-character-secret

# PostgreSQL 连接串按登录角色分开配置。
# 角色创建与口令分配属于部署引导动作：先由数据库管理员执行
# server/database/bootstrap/roles.sql 创建 schema_owner / app_api / app_worker / app_maintenance，
# 再分别 ALTER ROLE ... PASSWORD 下发口令；仓库内不保存任何数据库口令。
# 迁移作业专用凭据，只有它拥有业务对象。
DATABASE_URL_SCHEMA_OWNER=postgres://schema_owner:replace-me@localhost:5432/infinite_canvas
# API 进程凭据
DATABASE_URL_API=postgres://app_api:replace-me@localhost:5432/infinite_canvas
# Worker 进程凭据
DATABASE_URL_WORKER=postgres://app_worker:replace-me@localhost:5432/infinite_canvas
# 运维只读凭据
DATABASE_URL_MAINTENANCE=postgres://app_maintenance:replace-me@localhost:5432/infinite_canvas

# PostgreSQL 连接池上限（1-50）
DB_POOL_MAX=10

# 邮件发送配置，SMTP_USER / SMTP_PASSWORD 可留空
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# 腾讯云 COS 素材存储（可选整块；启用时必须五项全部配置）
# COS_SECRET_ID=replace-with-server-only-secret-id
# COS_SECRET_KEY=replace-with-server-only-secret-key
# COS_BUCKET=your-private-assets-1250000000
# COS_REGION=ap-guangzhou
# COS_SIGNED_URL_TTL_SECONDS=<positive-integer>

# ArtBox 视频 Provider（可选整块；启用时必须七项全部配置）
# 生产环境只接受 HTTPS origin，不要填 /v1 路径。
# ARTBOX_BASE_URL=<confirmed-https-api-origin>
# ARTBOX_API_KEY=replace-with-server-only-api-key
# ARTBOX_VIDEO_MODELS=Artdance 2 Mini-480p
# ARTBOX_REQUEST_TIMEOUT_MS=<positive-integer>
# ARTBOX_RESULT_MAX_BYTES=<positive-integer>
# ARTBOX_RESULT_ALLOWED_HOSTS=<exact-result-hostname>
# ARTBOX_POLL_LEASE_SECONDS=<positive-integer>
