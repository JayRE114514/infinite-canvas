APP_ORIGIN=https://119.45.218.41:9443
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

POSTGRES_ADMIN_PASSWORD=replace-with-random-hex
SCHEMA_OWNER_PASSWORD=replace-with-random-hex
APP_API_PASSWORD=replace-with-random-hex
APP_WORKER_PASSWORD=replace-with-random-hex
APP_MAINTENANCE_PASSWORD=replace-with-random-hex

# 留空时使用 Compose 内部 Mailpit，仅用于部署验收，不会向真实邮箱发送。
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@infinite-canvas.local

# 腾讯云 COS 素材存储（可选整块；启用时必须五项全部配置）
# 只保存在服务器 deploy/tencent/.env.production，不要提交真实凭据。
# COS_SECRET_ID=replace-with-server-only-secret-id
# COS_SECRET_KEY=replace-with-server-only-secret-key
# COS_BUCKET=your-private-assets-1250000000
# COS_REGION=ap-guangzhou
# COS_SIGNED_URL_TTL_SECONDS=<positive-integer>

# ArtBox 视频 Provider（可选整块；启用时必须七项全部配置）
# 生产环境必须是已确认的 HTTPS API origin，不要包含 /v1 路径。
# ARTBOX_BASE_URL=<confirmed-https-api-origin>
# ARTBOX_API_KEY=replace-with-server-only-api-key
# ARTBOX_VIDEO_MODELS=Artdance 2 Mini-480p
# ARTBOX_REQUEST_TIMEOUT_MS=<positive-integer>
# ARTBOX_RESULT_MAX_BYTES=<positive-integer>
# ARTBOX_RESULT_ALLOWED_HOSTS=<exact-result-hostname>
# ARTBOX_POLL_LEASE_SECONDS=<positive-integer>
