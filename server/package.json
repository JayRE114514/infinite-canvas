{
    "name": "@infinite-canvas/server",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev:api": "tsx watch src/api.ts",
        "dev:worker": "tsx watch src/worker.ts",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "check:boundaries": "tsx scripts/check-module-boundaries.ts src",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate"
    },
    "dependencies": {
        "@fastify/cors": "11.3.0",
        "@fastify/swagger": "9.8.1",
        "@fastify/type-provider-typebox": "6.1.0",
        "@infinite-canvas/contracts": "workspace:*",
        "better-auth": "1.7.1",
        "drizzle-orm": "0.45.2",
        "fastify": "5.12.1",
        "json-canonicalize": "3.0.0",
        "nodemailer": "9.0.5",
        "pg": "8.23.0",
        "pg-boss": "12.28.0",
        "typebox": "1.3.19"
    },
    "devDependencies": {
        "@types/node": "24.9.2",
        "@types/nodemailer": "8.0.1",
        "@types/pg": "8.23.1",
        "drizzle-kit": "0.31.10",
        "testcontainers": "12.1.0",
        "tsx": "4.23.12",
        "typescript": "5.9.3",
        "vitest": "4.1.11"
    }
}
